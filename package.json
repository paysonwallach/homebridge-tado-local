{
  "name": "homebridge-tado-local",
  "displayName": "Tado Local",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Bridge TadoLocal into HomeKit",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "homebridge-plugin"
  ],
  "scripts": {
    "build": "rimraf ./dist && tsc -p tsconfig.build.json",
    "watch": "npm run build && npm link && nodemon",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "dependencies": {
    "eventsource": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eventsource": "^1.1.15",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.0"
  }
}
